{
  "default_allow": false,
  "shell_start": {
    "admin": [
      "priv-lvl=15"
    ],
    "testadmin": [
      "priv-lvl=15"
    ],
    "alice": [
      "priv-lvl=15"
    ],
    "bob": [
      "priv-lvl=1"
    ]
  },
  "shell_start_groups": {
    "netops": [
      "priv-lvl=15"
    ]
  },
  "device_flow_exclude_users": [
    "svc-tenable",
    "svc-*"
  ],
  "enable_groups": {
    "15": [
      "netops"
    ]
  },
  "ascii_prompts": {
    "username": "Username:",
    "password": "Secret:"
  },
  "allow_raw_server_msg": true,
  "ascii_messages": {
    "success": "authentication succeeded",
    "failure": "invalid credentials",
    "abort": "authentication aborted"
  },
  "raw_server_msg_allow_prefixes": [],
  "raw_server_msg_deny_prefixes": [],
  "raw_server_msg_user_overrides": {
    "admin": {
      "allow": true,
      "allow_prefixes": [],
      "deny_prefixes": [],
      "allow_services": [
        1
      ],
      "allow_actions": [
        1,
        2
      ]
    },
    "testadmin": {
      "allow": true,
      "allow_prefixes": [],
      "deny_prefixes": [],
      "allow_services": [
        1
      ],
      "allow_actions": [
        1,
        2
      ]
    }
  },
  "rules": [
    {
      "id": "allow-show",
      "priority": 10,
      "effect": "allow",
      "pattern": "show(\\s+.*)?"
    },
    {
      "id": "deny-config",
      "priority": 50,
      "effect": "deny",
      "pattern": "(configure|conf)(\\s+.*)?"
    },
    {
      "id": "allow-all-admins",
      "priority": 60,
      "effect": "allow",
      "users": [
        "admin",
        "testadmin"
      ],
      "pattern": ".*"
    },
    {
      "id": "allow-netops",
      "priority": 70,
      "effect": "allow",
      "groups": [
        "netops"
      ],
      "pattern": ".*"
    }
  ]
}
