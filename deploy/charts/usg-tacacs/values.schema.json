{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["workloads", "image", "nads", "postgres", "secrets", "est", "management", "networkPolicy"],
  "properties": {
    "workloads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["management", "legacy", "tls"],
      "properties": {
        "management": {"$ref": "#/$defs/workload"},
        "legacy": {"$ref": "#/$defs/workload"},
        "tls": {"$ref": "#/$defs/workload"}
      }
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "nads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity", "sourceIp", "mode"],
        "properties": {
          "identity": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
          "sourceIp": {"type": "string", "format": "ipv4"},
          "description": {"type": "string"},
          "mode": {"enum": ["legacy", "tls"]},
          "secretFile": {"type": "string", "pattern": "^/"},
          "certificateIdentities": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "oneOf": [
          {
            "properties": {"mode": {"const": "legacy"}},
            "required": ["secretFile"],
            "not": {"required": ["certificateIdentities"]}
          },
          {
            "properties": {"mode": {"const": "tls"}},
            "required": ["certificateIdentities"],
            "not": {"required": ["secretFile"]}
          }
        ]
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "checkFiles"],
      "properties": {
        "description": {"type": "string"},
        "checkFiles": {"type": "boolean"}
      }
    },
    "postgres": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "pattern": "^postgresql://[^:]+@[^/]+/[^?]+\\?sslmode=verify-full$"}
      }
    },
    "secrets": {
      "type": "object",
      "required": ["runtime", "apiTls", "dataPlaneTls", "postgresCa"]
    },
    "est": {
      "type": "object",
      "additionalProperties": false,
      "required": ["management"],
      "properties": {
        "management": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "serverUrl",
            "commonName",
            "dnsSans",
            "organization",
            "caLabel",
            "bootstrapSecret",
            "authentication",
            "username",
            "renewalThreshold",
            "renewalCheckIntervalSeconds",
            "bootstrapTimeoutSeconds"
          ],
          "properties": {
            "enabled": {"type": "boolean"},
            "serverUrl": {"type": "string"},
            "commonName": {"type": "string"},
            "dnsSans": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
              }
            },
            "organization": {"type": "string"},
            "caLabel": {"type": "string"},
            "bootstrapSecret": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "authentication": {"enum": ["basic", "mtls"]},
            "username": {"type": "string"},
            "renewalThreshold": {"type": "integer", "minimum": 1, "maximum": 100},
            "renewalCheckIntervalSeconds": {"type": "integer", "minimum": 60},
            "bootstrapTimeoutSeconds": {"type": "integer", "minimum": 1}
          },
          "allOf": [
            {
              "if": {"properties": {"enabled": {"const": true}}},
              "then": {
                "properties": {
                  "serverUrl": {
                    "type": "string",
                    "pattern": "^https://\\S+/.well-known/est(?:/\\S+)?$"
                  },
                  "commonName": {"type": "string", "minLength": 1},
                  "dnsSans": {"minItems": 1}
                }
              }
            },
            {
              "if": {
                "properties": {
                  "enabled": {"const": true},
                  "authentication": {"const": "basic"}
                },
                "required": ["enabled", "authentication"]
              },
              "then": {"properties": {"username": {"minLength": 1}}}
            }
          ]
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "legacyLoadBalancerIP", "tlsLoadBalancerIP", "annotations"],
      "properties": {
        "type": {"enum": ["LoadBalancer", "NodePort"]},
        "legacyLoadBalancerIP": {"type": "string"},
        "tlsLoadBalancerIP": {"type": "string"},
        "annotations": {"type": "object"}
      }
    },
    "management": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjects"],
      "properties": {
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["certificateIdentity", "role"],
            "properties": {
              "certificateIdentity": {
                "type": "string",
                "pattern": "^(cn|dns|email|uri):\\S+$"
              },
              "role": {
                "enum": ["admin", "jitpw-issuer", "jitpw-auditor"]
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "managementPeers"],
      "properties": {
        "enabled": {"type": "boolean"},
        "managementPeers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "podLabels"],
            "properties": {
              "namespace": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "podLabels": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicaCount"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 1}
      }
    }
  }
}
