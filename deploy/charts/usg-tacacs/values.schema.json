{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["workloads", "image", "nads", "postgres", "secrets", "management", "networkPolicy"],
  "properties": {
    "workloads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["management", "legacy", "tls"],
      "properties": {
        "management": {"$ref": "#/$defs/workload"},
        "legacy": {"$ref": "#/$defs/workload"},
        "tls": {"$ref": "#/$defs/workload"}
      }
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "nads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity", "sourceIp", "mode"],
        "properties": {
          "identity": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
          "sourceIp": {"type": "string", "format": "ipv4"},
          "description": {"type": "string"},
          "mode": {"enum": ["legacy", "tls"]},
          "secretFile": {"type": "string", "pattern": "^/"},
          "certificateIdentities": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "oneOf": [
          {
            "properties": {"mode": {"const": "legacy"}},
            "required": ["secretFile"],
            "not": {"required": ["certificateIdentities"]}
          },
          {
            "properties": {"mode": {"const": "tls"}},
            "required": ["certificateIdentities"],
            "not": {"required": ["secretFile"]}
          }
        ]
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "checkFiles"],
      "properties": {
        "description": {"type": "string"},
        "checkFiles": {"type": "boolean"}
      }
    },
    "postgres": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "pattern": "^postgresql://[^:]+@[^/]+/[^?]+\\?sslmode=verify-full$"}
      }
    },
    "secrets": {
      "type": "object",
      "required": ["runtime", "apiTls", "dataPlaneTls", "postgresCa"]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "legacyLoadBalancerIP", "tlsLoadBalancerIP", "annotations"],
      "properties": {
        "type": {"enum": ["LoadBalancer", "NodePort"]},
        "legacyLoadBalancerIP": {"type": "string"},
        "tlsLoadBalancerIP": {"type": "string"},
        "annotations": {"type": "object"}
      }
    },
    "management": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjects"],
      "properties": {
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["certificateIdentity", "role"],
            "properties": {
              "certificateIdentity": {
                "type": "string",
                "pattern": "^(cn|dns|email|uri):\\S+$"
              },
              "role": {
                "enum": ["admin", "jitpw-issuer", "jitpw-auditor"]
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "managementPeers"],
      "properties": {
        "enabled": {"type": "boolean"},
        "managementPeers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "podLabels"],
            "properties": {
              "namespace": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "podLabels": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicaCount"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 1}
      }
    }
  }
}
