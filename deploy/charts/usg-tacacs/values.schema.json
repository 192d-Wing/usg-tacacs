{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["image", "nads", "postgres", "secrets", "management", "networkPolicy"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "nads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity", "sourceIp", "secretFile"],
        "properties": {
          "identity": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
          "sourceIp": {"type": "string", "format": "ipv4"},
          "description": {"type": "string"},
          "secretFile": {"type": "string", "pattern": "^/"}
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "checkFiles"],
      "properties": {
        "description": {"type": "string"},
        "checkFiles": {"type": "boolean"}
      }
    },
    "postgres": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "pattern": "^postgresql://[^:]+@[^/]+/[^?]+\\?sslmode=verify-full$"}
      }
    },
    "secrets": {
      "type": "object",
      "required": ["runtime", "apiTls", "postgresCa"]
    },
    "management": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjects"],
      "properties": {
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["certificateIdentity", "role"],
            "properties": {
              "certificateIdentity": {
                "type": "string",
                "pattern": "^(cn|dns|email|uri):\\S+$"
              },
              "role": {
                "enum": ["admin", "jitpw-issuer", "jitpw-auditor"]
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "managementPeers"],
      "properties": {
        "enabled": {"type": "boolean"},
        "managementPeers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "podLabels"],
            "properties": {
              "namespace": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "podLabels": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
