# syntax=docker/dockerfile:1
# Native musl build (used for both amd64 and arm64 release matrix entries).
#
# Dependency compilation is cached as its own layer via cargo-chef so a source
# or version change does NOT trigger a full recompile of the (slow) dependency
# graph — aws-lc-sys/openssl-static, ring, tokio, etc. Only the workspace crates
# recompile on a normal change. Pairs with the registry layer cache
# (cache-to/from type=registry,mode=max) in .github/workflows/release.yml.
ARG TARGETPLATFORM=linux/arm64

FROM rust:1.95-alpine AS chef
RUN apk add --no-cache \
    build-base \
    cmake \
    go \
    musl-dev \
    openssl-dev \
    openssl-libs-static \
    perl \
    pkgconfig
RUN cargo install cargo-chef --locked
WORKDIR /app

FROM chef AS planner
COPY . .
# Normalize the workspace version before computing the recipe so a release
# version bump does NOT change recipe.json — otherwise every release would bust
# the cached dependency layer. Only external dependencies are built in `cook`;
# the real version is restored from the build context in the builder stage, so
# the final binary still reports the correct version.
RUN sed -i 's/^version = .*/version = "0.0.0"/' Cargo.toml \
    && cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
# Heavy, cacheable layer: compile ONLY dependencies. Reused across builds as
# long as the dependency graph (recipe.json) is unchanged.
RUN cargo chef cook --release -p usg-tacacs-server --recipe-path recipe.json
# Real source (with the real version) — compiles just the workspace crates.
COPY . .
RUN cargo build --release -p usg-tacacs-server

FROM registry1.dso.mil/ironbank/opensource/alpinelinux/alpine:3.22
RUN apk add --no-cache ca-certificates
WORKDIR /app

RUN adduser -D -H -s /sbin/nologin tacacs
USER tacacs

COPY --from=builder /app/target/release/usg-tacacs-server /usr/local/bin/usg-tacacs

EXPOSE 300/tcp 49/tcp
ENTRYPOINT ["/usr/local/bin/usg-tacacs"]
CMD ["--help"]
